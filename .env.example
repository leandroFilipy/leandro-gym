# Banco (local: rode `npx prisma dev` e cole a URL postgres:// que ele mostrar)
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Auth.js — gere com: npx auth secret   (ou qualquer string aleatória longa)
AUTH_SECRET="troque-isto-por-uma-string-aleatoria-longa"
AUTH_TRUST_HOST=true

# URL pública do app (usada em links de e-mail)
APP_URL="http://localhost:3000"

# Fase 2 — e-mails e cron (opcionais)
RESEND_API_KEY=""
EMAIL_FROM="Leandro Gym <treino@seudominio.com>"
CRON_SECRET="troque-isto"

# Fase 2 — push notifications (opcional). Gere o par com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:voce@seudominio.com"
